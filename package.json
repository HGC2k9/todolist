{
  "name": "cloudflare-todo-list",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create todo-db",
    "db:init:local": "wrangler d1 execute todo-db --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute todo-db --remote --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute todo-db --remote --file=./migration_pinned.sql",
    "db:seed:local": "wrangler d1 execute todo-db --local --file=./seed.sql",
    "db:seed:remote": "wrangler d1 execute todo-db --remote --file=./seed.sql",
    "test": "tsx test/auth.test.ts"
  },
  "dependencies": {
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/push-notifications": "^8.1.3",
    "@types/web-push": "^3.6.4",
    "hono": "^4.6.0",
    "web-push": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241106.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "wrangler": "^3.91.0"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true,
    "sharp": true
  }
}
