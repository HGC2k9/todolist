{
  "name": "cloudflare-todo-list",
  "version": "2.3.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create todo-db",
    "db:init:local": "wrangler d1 execute todo-db --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute todo-db --remote --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute todo-db --remote --file=./migration_pinned.sql",
    "db:seed:local": "wrangler d1 execute todo-db --local --file=./seed.sql",
    "db:seed:remote": "wrangler d1 execute todo-db --remote --file=./seed.sql",
    "test": "tsx test/auth.test.ts && tsx test/recurring.test.ts && tsx test/telegram.test.ts && tsx test/api.test.ts && tsx test/webhook.test.ts && tsx test/v2_features.test.ts && tsx test/v3_features.test.ts",
    "build": "tsx scripts/build.ts",
    "cap:sync": "npm run build && cap sync ios",
    "cap:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor/camera": "^8.2.6",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capgo/capacitor-updater": "^8.54.2",
    "capacitor-voice-recorder": "^7.0.6",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241106.0",
    "@playwright/test": "^1.65.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "wrangler": "^3.91.0"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true,
    "sharp": true
  }
}
